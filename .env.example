# ============================================
# YouTube AI Assistant - Environment Variables
# ============================================

# --- AI Providers ---
GEMINI_API_KEY=your-gemini-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
GROK_API_KEY=your-grok-api-key
DEFAULT_AI_PROVIDER=gemini

# --- Google / YouTube ---
GOOGLE_API_KEY=your-google-api-key
YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret
YOUTUBE_REFRESH_TOKEN=your-youtube-refresh-token
YOUTUBE_CHANNEL_ID=your-channel-id

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# --- Database ---
DATABASE_URL=sqlite:///./storage/youtube_ai.db
# DATABASE_URL=postgresql://user:pass@host:5432/youtube_ai

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- TTS Providers ---
ELEVENLABS_API_KEY=your-elevenlabs-api-key
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus
DEFAULT_TTS_PROVIDER=google

# --- Cloud Storage (Cloudflare R2) ---
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET=youtube-ai-assets
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com

# --- JWT ---
JWT_SECRET_KEY=your-super-secret-jwt-key-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- App ---
APP_NAME=YouTube AI Assistant
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Channel Settings ---
CHANNEL_LANGUAGE=bn
CHANNEL_NAME=AI Bangla
DEFAULT_CATEGORY=ai-tools
UPLOAD_TIME=18:00
TIMEZONE=Asia/Dhaka
VOICE_NAME=bn-IN-Wavenet-A
VIDEO_DURATION=60
SHORTS_ENABLED=true
LONG_VIDEO_ENABLED=false

# --- Vercel ---
VERCEL_TOKEN=your-vercel-token
